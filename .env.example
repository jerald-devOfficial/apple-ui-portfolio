MONGODB_URI=

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:4000

NEXT_PUBLIC_NEWS_DATA_API_KEY=

# The address shown in the "My MetaMask" panel; public by nature.
NEXT_PUBLIC_METAMASK_ADDRESS=
# Server-side only: /api/eth-balance and /api/eth-transaction proxy Etherscan so
# the key is never shipped to the browser. Do not set NEXT_PUBLIC_ETHERSCAN_API_KEY;
# that leftover name is ignored. Etherscan V1 is retired — the key must be a V2
# key from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=

NEXT_PUBLIC_TINYMCE_API_KEY=

NEXT_PUBLIC_ADMIN_EMAIL=your-admin@example.com

# Cloudflare R2
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_USERS_BUCKET_NAME=
NEXT_PUBLIC_R2_URL=

# Resend — verify your sending domain at https://resend.com/domains before production use
RESEND_API_KEY=
CONTACT_FROM="Portfolio Contact <contact@yourdomain.com>"
CONTACT_TO=your-admin@example.com

# Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
# Dev test keys (always pass): site=1x00000000000000000000AA secret=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- End-to-end tests (yarn test:func) ---
# MONGODB_URI above must point at a TEST database when running E2E — never production.
# Playwright targets http://localhost:$PORT by default; override only to test a
# deployed environment. NEXT_PUBLIC_APP_URL is intentionally not used here.
E2E_BASE_URL=
# Skip the docker-compose.e2e.yml MongoDB when Mongo already runs elsewhere.
E2E_SKIP_DOCKER_MONGO=
# Required opt-in for `yarn seed:e2e`; the seed refuses to run without it.
E2E_SEED_ENABLED=
E2E_TEST_USER_EMAIL=
# Only needed if an E2E-only Credentials provider is added (Option A in e2e/README.md).
E2E_TEST_USER_PASSWORD=
